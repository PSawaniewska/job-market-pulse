   "cell_type": "markdown",
   "source": "## What are the top 15 most in-demand skills?",
   "id": "2919e30957af5106"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-08-10T19:37:33.939169500Z",
     "start_time": "2026-08-10T19:37:33.887213800Z"
    }
   },
   "cell_type": "code",
   "source": [
    "%%sql\n",
    "SELECT skills, COUNT(*) as count\n",
    "FROM skills\n",
    "GROUP BY skills\n",
    "ORDER BY count DESC\n",
    "LIMIT 15;"
   ],
